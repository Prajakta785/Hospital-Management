{
  "name": "hospital-management",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"vite\"",
    "dev:frontend": "vite",
    "dev:all": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run dev\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "server": "node --watch-path=server/index.js --watch-path=server/routes --watch-path=server/middleware --watch-path=server/services --watch-path=server/config server/index.js",
    "server:dev": "node --watch-path=server/index.js --watch-path=server/routes --watch-path=server/middleware --watch-path=server/services --watch-path=server/config server/index.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "date-fns": "^4.4.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "firebase": "^13.3.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.64.0",
    "morgan": "^1.10.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5"
  }
}
